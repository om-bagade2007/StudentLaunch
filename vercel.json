{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "../backend/public" }
    },
    { "src": "backend/api/health.js", "use": "@vercel/node" },
    { "src": "backend/api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/health", "dest": "backend/api/health.js" },
    { "src": "/api/(.*)", "dest": "backend/api/index.js" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/favicon.svg", "dest": "/favicon.svg" },
    { "src": "/icons.svg", "dest": "/icons.svg" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
